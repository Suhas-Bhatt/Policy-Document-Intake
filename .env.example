# ---- Flask ----
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_EXPIRY_MINUTES=60

# ---- AWS ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# API Gateway endpoint that proxies uploads into S3 (see aws/apigateway/s3-proxy-integration.md)
API_GATEWAY_UPLOAD_URL=https://{api-id}.execute-api.us-east-1.amazonaws.com/prod/documents

S3_BUCKET_NAME=policy-documentz
DYNAMODB_TABLE_NAME=PolicyDocumentProcessing
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:{aws-account-id}:policy-document-notifications

# ---- Snowflake ----
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
