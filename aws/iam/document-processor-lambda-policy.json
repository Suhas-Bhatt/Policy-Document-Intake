{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadUploadedDocuments",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::policy-documentz/incoming/*"
    },
    {
      "Sid": "UpdateProcessingMetadata",
      "Effect": "Allow",
      "Action": ["dynamodb:UpdateItem", "dynamodb:GetItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:312816040566:table/PolicyDocumentProcessing"
    },
    {
      "Sid": "PublishCompletion",
      "Effect": "Allow",
      "Action": ["sns:Publish"],
      "Resource": "arn:aws:sns:us-east-1:312816040566:policy-document-notifications"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:312816040566:*"
    }
  ]
}
